# Copy this file to `.env`, fill in the real values from Supabase's Connect dialog
# (Session pooler tab), then paste the filled-in .env into Render: Service ->
# Environment -> "Add from .env". This file is never read locally by Spring Boot
# itself (it only reads real env vars / -D system properties) -- it's just a
# convenient place to keep the values straight before pasting them into Render.

# From Supabase: Connect -> Session pooler tab
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DATABASE_USER=postgres.rbmfcjzlltefwzuwjocj
DATABASE_PASSWORD=your-supabase-db-password

# Must match your deployed Vercel frontend URL exactly (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
